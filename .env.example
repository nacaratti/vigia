# Copie para .env e preencha. NUNCA versione o .env.

# Gravador (DVR) — use de preferência um usuário só de visualização criado no DVR
CAM_HOST=192.168.1.100
CAM_RTSP_PORT=554
CAM_USER=admin
CAM_PASSWORD=troque-me

# Telegram: crie o bot com o @BotFather; para o chat id rode scripts/telegram_chat_id.py
# Vários destinatários: separe por vírgula (cada pessoa precisa mandar "oi" ao bot antes)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Painel: só é necessário para abrir fora deste PC (--host). Mínimo 10 caracteres.
# PAINEL_SENHA=
